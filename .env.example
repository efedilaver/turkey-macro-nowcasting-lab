# Bu dosyayı .env adıyla kopyala ve anahtarlarını yaz. .env git'e eklenmez.
# Ajanlar .env okuyamaz; betikler python-dotenv ile okur.
# Kontrol: python src/veri/anahtar_kontrol.py --baglan  (değerleri yazdırmaz)
# Hesap açma adımları: katalog/RAPOR.md §10

# --- A. Kayıtlı kartlar için gerekli (H-001..H-003) ---
# TCMB EVDS3: evds3.tcmb.gov.tr → Profil → API anahtarı (HTTP başlığında `key`).
EVDS_API_KEY=
# EPİAŞ Şeffaflık: kullanıcı adı kayıt e-postasıdır; betik bunlarla TGT bileti alır.
EPIAS_KULLANICI=
EPIAS_SIFRE=
# Yalnız H-003 için yedek: NO2 dosyaları AWS meeo-s5p kovasından anahtarsız alınır.
# NASA Earthdata: urs.earthdata.nasa.gov → Generate Token (bearer belirteci, süresi dolar).
EARTHDATA_TOKEN=
# Copernicus Data Space: dataspace.copernicus.eu kullanıcı adı ve parolası.
CDSE_KULLANICI=
CDSE_SIFRE=

# --- B. Sonraki turlar ---
# Google Earth Engine proje kimliği (ayrıca `earthengine authenticate` gerekir).
GEE_PROJECT=
# NASA FIRMS MAP_KEY (e-postayla gelir).
FIRMS_MAP_KEY=
# USGS ERS / M2M: kullanıcı adı ve uygulama belirteci.
USGS_KULLANICI=
USGS_TOKEN=
# OpenSky OAuth2 istemcisi (credentials.json içindeki değerler).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# ENTSO-E RESTful API güvenlik belirteci.
ENTSOE_TOKEN=
